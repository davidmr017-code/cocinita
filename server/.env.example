# Copia a .env en local o configura en Railway
DATABASE_URL=postgresql://user:pass@host:5432/railway
DATABASE_SSL=true
JWT_SECRET=cambia-este-secreto-largo
PORT=3080
CORS_ORIGINS=http://localhost:5173,https://tu-app.vercel.app
# Chef IA (recetas con la despensa) — clave gratuita en https://console.groq.com
GROQ_API_KEY=
# Opcional: modelo de Groq (por defecto llama-3.3-70b-versatile)
GROQ_MODEL=
